# Legacy 0.1 template; current Light/Full specs are generated by scripts/package-editions.py.
Name: retoolkit-linux
Version: 0.1.0
Release: 1
Summary: Native reverse engineering workstation manager
License: MIT
BuildArch: x86_64
Requires: glibc >= 2.39
Requires: gtk4 >= 4.10
Requires: libadwaita >= 1.4
Recommends: polkit, xdg-utils, gnome-terminal
%description
Native GTK4/libadwaita manager for reverse engineering tools and static inspection.
%install
mkdir -p %{buildroot}/usr/bin %{buildroot}/usr/share/applications %{buildroot}/usr/share/icons/hicolor/scalable/apps %{buildroot}/usr/share/licenses/retoolkit-linux
install -m755 %{getenv:RETOOLKIT_SOURCE}/target/release/retoolkit-linux %{buildroot}/usr/bin/retoolkit-linux
install -m644 %{getenv:RETOOLKIT_SOURCE}/packaging/desktop/io.github.retoolkitlinux.REtoolkit.desktop %{buildroot}/usr/share/applications/
install -m644 %{getenv:RETOOLKIT_SOURCE}/assets/icons/retoolkit-linux.svg %{buildroot}/usr/share/icons/hicolor/scalable/apps/
install -m644 %{getenv:RETOOLKIT_SOURCE}/LICENSE %{buildroot}/usr/share/licenses/retoolkit-linux/
cp -a %{getenv:RETOOLKIT_SOURCE}/.build/licenses %{buildroot}/usr/share/licenses/retoolkit-linux/third-party
%files
/usr/bin/retoolkit-linux
/usr/share/applications/io.github.retoolkitlinux.REtoolkit.desktop
/usr/share/icons/hicolor/scalable/apps/retoolkit-linux.svg
/usr/share/licenses/retoolkit-linux/LICENSE
/usr/share/licenses/retoolkit-linux/third-party
%changelog
* Fri Oct 23 2026 REtoolkit Linux contributors - 0.1.0-1
- Initial native implementation.
