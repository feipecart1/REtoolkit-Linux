#!/bin/sh
set -eu
APPDIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
export RETOOLKIT_APPDIR="$APPDIR"
export RETOOLKIT_HOST_LD_LIBRARY_PATH="${LD_LIBRARY_PATH-}"
export RETOOLKIT_HOST_XDG_DATA_DIRS="${XDG_DATA_DIRS-/usr/local/share:/usr/share}"
export RETOOLKIT_HOST_GSETTINGS_SCHEMA_DIR="${GSETTINGS_SCHEMA_DIR-}"
export LD_LIBRARY_PATH="$APPDIR/usr/lib:$APPDIR/usr/lib/x86_64-linux-gnu${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export XDG_DATA_DIRS="$APPDIR/usr/share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
export GSETTINGS_SCHEMA_DIR="$APPDIR/usr/share/glib-2.0/schemas"
exec "$APPDIR/usr/bin/retoolkit-linux" "$@"
